{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Rubrion account (the deployed demo at agent-kit.rubrion.ai). Change or remove in a copy.
	"account_id": "1da13e1445adbf8765ae19ae46ba7ac8",
	"name": "agent-kit-demo",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-10-14",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "agent-kit.rubrion.ai", "custom_domain": true }],
	// The React app; /api/* goes to the Worker first.
	"assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
	"services": [{ "binding": "AGENT", "service": "agent-kit-demo-agent" }],
	"vars": {
		// Cloudflare Access protects the hostname; the Worker verifies the JWT too.
		"ACCESS_TEAM_DOMAIN": "rubrion.cloudflareaccess.com",
		"ACCESS_AUD": "4539c9ffa1119d90d474d7a3018dee77e994057f5d3a82866a29f8a1367ad53e",
		// Local dev only (wrangler/vite dev): who you are without Access. Leave empty in production.
		"DEV_USER": ""
	}
}
